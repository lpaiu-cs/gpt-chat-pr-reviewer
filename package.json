{
  "name": "gpt-chat-pr-reviewer",
  "version": "0.3.0",
  "description": "ChatGPT 웹 대화창(chat)을 이용한 상태 머신 기반 GitHub PR 자동 리뷰",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lpaiu-cs/gpt-chat-pr-reviewer.git"
  },
  "keywords": [
    "chatgpt",
    "code-review",
    "pull-request",
    "playwright",
    "state-machine"
  ],
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist/",
    "scripts/daemon.mjs",
    "scripts/install-skills.mjs",
    "scripts/notify.mjs",
    "skills/",
    "docs/",
    "AGENTS.md",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "bin": {
    "pr-review": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-ui.mjs",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "setup": "tsx src/cli.ts setup",
    "review": "tsx src/cli.ts review",
    "watch": "tsx src/cli.ts watch",
    "status": "tsx src/cli.ts status",
    "smoke": "tsx scripts/smoke-machine.ts",
    "test": "tsx --test tests/*.test.ts",
    "smoke:install": "node scripts/smoke-install-skills.mjs",
    "notify": "node scripts/notify.mjs",
    "install-skills": "node scripts/install-skills.mjs",
    "daemon": "node scripts/daemon.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "chalk": "^5.4.1",
    "commander": "^13.1.0",
    "playwright": "^1.52.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
